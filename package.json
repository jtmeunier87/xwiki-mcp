{
  "name": "@jtmeunier87/xwiki-mcp",
  "version": "0.14.1",
  "description": "MCP server for XWiki REST API",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "xwiki-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run --exclude 'dist/**'",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "xwiki",
    "model-context-protocol",
    "claude",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jtmeunier87/xwiki-mcp.git"
  },
  "homepage": "https://github.com/jtmeunier87/xwiki-mcp",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
