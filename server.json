{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.jtmeunier87/xwiki-mcp",
  "title": "XWiki",
  "description": "Read and write an XWiki instance: pages, objects, classes, attachments, tags, history and search.",
  "repository": {
    "url": "https://github.com/jtmeunier87/xwiki-mcp",
    "source": "github"
  },
  "version": "0.23.2",
  "packages": [
    {
      "registryType": "oci",
      "identifier": "ghcr.io/jtmeunier87/xwiki-mcp:0.23.2",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "XWIKI_BASE_URL",
          "description": "Wiki base URL without /rest, e.g. https://wiki.example.com",
          "isRequired": true
        },
        {
          "name": "XWIKI_AUTH_TYPE",
          "description": "basic, token or none",
          "default": "basic"
        },
        {
          "name": "XWIKI_USERNAME",
          "description": "xWiki user for basic auth"
        },
        {
          "name": "XWIKI_PASSWORD",
          "description": "Password for basic auth",
          "isSecret": true
        },
        {
          "name": "XWIKI_TOKEN",
          "description": "Bearer token for token auth",
          "isSecret": true
        },
        {
          "name": "XWIKI_MCP_READ_ONLY",
          "description": "true registers read tools only",
          "default": "false"
        },
        {
          "name": "XWIKI_MCP_ALLOW_DELETE",
          "description": "true also registers delete tools",
          "default": "false"
        }
      ]
    }
  ]
}
